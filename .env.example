# Copy this file to .env and fill in your values.
GOOGLE_API_KEY=

# Model used by the eval LLM judge (python -m evals.run_eval --judge).
# Use a different model from LLM_MODEL so the system isn't grading itself.
JUDGE_MODEL=

# Prompt-injection defences, comma-separated: prompt, trust, links (trust requires prompt).
# Leave empty for none.
DEFENCES=
