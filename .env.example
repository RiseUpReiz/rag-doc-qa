# Copy this file to .env and fill in your values.
GOOGLE_API_KEY=

# Model used by the eval LLM judge (python -m evals.run_eval --judge).
# Use a different model from LLM_MODEL so the system isn't grading itself.
JUDGE_MODEL=

# Prompt-injection defences, comma-separated: prompt, trust, links (trust requires prompt).
# Leave empty for none.
DEFENCES=

# Manifest of approved documents for the "trust" defence (python -m app.trust make-manifest ...).
# Required when DEFENCES includes trust; the index must be rebuilt after it changes.
TRUSTED_SOURCES_PATH=trusted_sources.json

# Domains the "links" defence allows in answers, comma-separated (subdomains included).
# Leave empty to remove every link and email address.
ALLOWED_LINK_DOMAINS=
